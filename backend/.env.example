# PostgreSQL connection used by Prisma CLI and the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ict_knowledge_base?schema=public"

# สร้าง secret ใหม่ด้วย `npm run secret:generate` หรือคำสั่ง:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# นำค่าที่ได้ไปแทนค่าตัวอย่างก่อนเริ่มระบบ
JWT_SECRET="replace-this-with-a-random-secret-at-least-32-characters-long"

# Used only by `npm run admin:create`; never commit the actual credentials.
ADMIN_INITIAL_USERNAME="ict-admin"
ADMIN_INITIAL_FULLNAME="ICT Administrator"
ADMIN_INITIAL_PASSWORD="replace-with-a-unique-password-12-chars-or-longer"

PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"

# ปล่อยว่างเพื่อปิด trust proxy; ตั้งเป็นจำนวน proxy หรือค่าที่ Express รองรับ
TRUST_PROXY=
